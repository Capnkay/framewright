{
  "name": "framewright",
  "private": true,
  "version": "0.1.0",
  "description": "Framewright — wireframe, code, or prompt to a CMS-ready React section, with a live preview and store-backed editing.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node tools/test.mjs",
    "check-store-liveness": "node tools/check-store-liveness.mjs",
    "server": "node server/src/server.js",
    "build": "node -e \"const f=require('node:fs');f.rmSync('public',{recursive:true,force:true});f.cpSync('docs/html','public',{recursive:true})\"",
    "vercel-build": "node -e \"const f=require('node:fs');f.rmSync('public',{recursive:true,force:true});f.cpSync('docs/html','public',{recursive:true})\""
  },
  "devDependencies": {
    "mongodb": "^7.5.0",
    "mongodb-memory-server": "^11.2.0"
  }
}
