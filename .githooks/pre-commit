#!/bin/sh
# .githooks/pre-commit
#
# NOT a Claude Code hook — a real git hook. Active once this repository's
# hooks path is set: `git config core.hooksPath .githooks` (see SETUP.md).
#
# Fails closed: a secret found in staged content, a missing or mismatched
# LAW-MANIFEST.sha256, or any internal error below (a missing tool, an
# unreadable file) all produce a non-zero exit and block the commit. Nothing
# in this script is allowed to swallow an error and continue as if it
# passed.

fail() {
  echo "pre-commit: $1" >&2
  exit 1
}

# --- required tools, checked up front so a missing tool fails closed -------

for tool in git grep sha256sum; do
  command -v "$tool" >/dev/null 2>&1 || fail "required tool not found on PATH: $tool"
done

# --- 1. secret scan over staged content (the index, not the working tree) --

SECRET_PATTERNS='AKIA[0-9A-Z]{16}|sk-ant-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9_-]{20,}|gh[po]_[A-Za-z0-9]{36,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(sk|pk)_(live|test)_[A-Za-z0-9]{20,}'
PLACEHOLDER_PATTERN='YOUR[_-]|placeholder|xxx|example\.com|changeme|change_me|dummy|redacted|sample'

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
STAGED_FILES_STATUS=$?
[ "$STAGED_FILES_STATUS" -eq 0 ] || fail "could not list staged files (git diff --cached failed)"

if [ -n "$STAGED_FILES" ]; then
  OLDIFS=$IFS
  IFS='
'
  for f in $STAGED_FILES; do
    [ -z "$f" ] && continue
    content=$(git show ":$f" 2>/dev/null)
    [ -z "$content" ] && continue
    match=$(printf '%s\n' "$content" | grep -E -o "$SECRET_PATTERNS")
    if [ -n "$match" ]; then
      clean=$(printf '%s\n' "$match" | grep -Ev "$PLACEHOLDER_PATTERN")
      if [ -n "$clean" ]; then
        IFS=$OLDIFS
        fail "possible secret detected in staged file: $f"
      fi
    fi
  done
  IFS=$OLDIFS
fi

# --- 2. LAW-MANIFEST.sha256 — covers .claude/hooks/, .gitignore, .githooks/ -

[ -f "LAW-MANIFEST.sha256" ] || fail "LAW-MANIFEST.sha256 is missing"

sha256sum -c LAW-MANIFEST.sha256 >/dev/null 2>&1
MANIFEST_STATUS=$?
if [ "$MANIFEST_STATUS" -ne 0 ]; then
  fail "LAW-MANIFEST.sha256 verification failed — a covered file is missing or does not match its recorded hash. Run: sha256sum -c LAW-MANIFEST.sha256"
fi

# --- 3. the committer holds at least one open claim (docs/BATON.md) --------
#
# "Open" means an active claim file under _build/claims/ — one whose status
# field is "active". A missing _build/claims/ directory or an unreadable
# claim file fails closed, same as every other check in this script.

[ -d "_build/claims" ] || fail "_build/claims/ is missing — run: node tools/baton.mjs claim <id>"

# Whose claim counts: this machine's identity, resolved exactly as the baton
# tool resolves it. Checking for ANY open claim would mean one person's claim
# lets everybody else commit -- and a committed claim would act as a permanent
# skeleton key for every future clone. Verified: that is what happened before
# this check filtered by identity.
ME=""
if [ -f "_build/.me" ]; then
  ME=$(head -n 1 "_build/.me" 2>/dev/null | tr -d '
' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
fi
if [ -z "$ME" ]; then
  ME=$(git config user.name 2>/dev/null || true)
fi
if [ -z "$ME" ]; then
  fail "cannot tell who you are. Put your name in _build/.me, or set: git config user.name \"Your Name\""
fi

HAS_OPEN_CLAIM=0
for f in _build/claims/*.json; do
  [ -e "$f" ] || continue
  content=$(cat "$f" 2>/dev/null) || fail "could not read claim file: $f"
  # Must belong to this identity AND be a claim they actually took --
  # "active" (in flight) or "done" (finished, verification passed).
  #
  # Why "done" counts: the ritual is build -> baton done -> commit. `done`
  # marks the claim complete, so requiring "active" here would block the very
  # commit that step 8 of the ritual asks for -- on every task, for everyone.
  # Verified: that is exactly what happened before this line accepted "done".
  # Per-commit attribution comes from the task id the commit-msg hook requires;
  # this check answers the coarser question of whether you took the work at all.
  case "$content" in
    *'"status": "active"'*|*'"status":"active"'*) ;;
    *'"status": "done"'*|*'"status":"done"'*) ;;
    *) continue ;;
  esac
  case "$content" in
    *"\"who\": \"$ME\""*|*"\"who\":\"$ME\""*)
      HAS_OPEN_CLAIM=1
      break
      ;;
  esac
done

if [ "$HAS_OPEN_CLAIM" -ne 1 ]; then
  fail "$ME holds no open claim. Run: node tools/baton.mjs claim <id>, push the claim, then commit your work on it."
fi

# --- 4. the commit message contains a task id matching T-[0-9]{3} ----------
#
# Git's own hook lifecycle runs pre-commit BEFORE the commit message exists
# for the commit in progress — this is true for every commit style,
# including `git commit -m`, not just the interactive editor case. Verified
# directly: instrumenting a scratch repo's pre-commit to print
# .git/COMMIT_EDITMSG shows it absent at this stage even under `-m`. That
# makes pre-commit structurally unable to see the CURRENT message; the
# authoritative check lives in .githooks/commit-msg, which git guarantees
# receives the real, finalised message path as $1.
#
# So: if a message file is genuinely absent (the normal case for a fresh
# commit), this step does not fail — it defers to commit-msg, which git will
# still run next and which still blocks the commit if the id is missing.
# Hard-failing here on absence would brick every real commit before
# commit-msg ever got a chance to run, which is worse than not checking at
# all — see docs/BATON.md's own warning about a floor that blocks legitimate
# work getting removed at three in the morning.
#
# If a message file DOES exist here (direct/manual invocation for testing —
# see SETUP.md's `sh .githooks/pre-commit` pattern — or a leftover
# COMMIT_EDITMSG from a prior attempt), it is still checked and still fails
# closed on a missing id or an unreadable file. Nothing here silently
# swallows a real error.

COMMIT_MSG_FILE="${1:-.git/COMMIT_EDITMSG}"
if [ -f "$COMMIT_MSG_FILE" ]; then
  COMMIT_MSG=$(cat "$COMMIT_MSG_FILE" 2>/dev/null) || fail "could not read the commit message file: $COMMIT_MSG_FILE"
  echo "$COMMIT_MSG" | grep -Eq 'T-[0-9]{3}'
  if [ $? -ne 0 ]; then
    fail "commit message must contain a task id matching T-[0-9]{3} (e.g. \"T-018: automate the store-liveness assertion\")"
  fi
fi

exit 0
