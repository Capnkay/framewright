#!/bin/sh
# .githooks/pre-push
#
# NOT a Claude Code hook — a real git hook. Active once this repository's
# hooks path is set: `git config core.hooksPath .githooks` (see SETUP.md).
#
# The pre-submit gate over FULL history (docs/CONTRACT.md section 14). Runs
# every check against `git log -p --all`, not just the working tree or the
# current branch — a secret removed in a later commit is still a leak.
#
# Fails closed: any failed assertion below, or any internal error (a missing
# tool, a failed git command), produces a non-zero exit and blocks the push.

fail() {
  echo "pre-push: $1" >&2
  exit 1
}

for tool in git grep sed sort mktemp; do
  command -v "$tool" >/dev/null 2>&1 || fail "required tool not found on PATH: $tool"
done

TMPFILE=$(mktemp) || fail "could not create a temp file for the history dump"
trap 'rm -f "$TMPFILE"' EXIT

git log -p --all > "$TMPFILE" 2>/dev/null
GIT_LOG_STATUS=$?
[ "$GIT_LOG_STATUS" -eq 0 ] || fail "git log -p --all failed"

# --- 1. secret scan over full history ---------------------------------------

SECRET_PATTERNS='AKIA[0-9A-Z]{16}|sk-ant-[A-Za-z0-9_-]{20,}|sk-(proj-)?[A-Za-z0-9_-]{20,}|gh[po]_[A-Za-z0-9]{36,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(sk|pk)_(live|test)_[A-Za-z0-9]{20,}'
PLACEHOLDER_PATTERN='YOUR[_-]|placeholder|xxx|example\.com|changeme|change_me|dummy|redacted|sample'

MATCHES=$(grep -E -o "$SECRET_PATTERNS" "$TMPFILE" | grep -Ev "$PLACEHOLDER_PATTERN")
if [ -n "$MATCHES" ]; then
  fail "possible secret found in full git history (git log -p --all)"
fi

# --- 2. .env.example must be tracked AND contain only placeholders ---------

git ls-files --error-unmatch .env.example >/dev/null 2>&1
[ $? -eq 0 ] || fail ".env.example is not tracked — it must be, and it must contain only placeholders"

ENV_EXAMPLE_CONTENT=$(git show HEAD:.env.example 2>/dev/null)
[ -n "$ENV_EXAMPLE_CONTENT" ] || fail "could not read the tracked .env.example at HEAD"

BAD_ENV_LINE=""
OLDIFS=$IFS
IFS='
'
for line in $ENV_EXAMPLE_CONTENT; do
  trimmed=$(printf '%s' "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
  case "$trimmed" in
    ''|'#'*) continue ;;
  esac
  case "$trimmed" in
    *=*)
      rhs=$(printf '%s' "$trimmed" | sed 's/^[^=]*=//')
      case "$rhs" in
        ''|*YOUR_*|*YOUR-*|*placeholder*|*PLACEHOLDER*|*xxx*|*XXX*|*example.com*|*localhost*|*127.0.0.1*|*changeme*|*CHANGEME*|*change_me*|*dummy*|*DUMMY*|*redacted*|*REDACTED*|*sample*|*SAMPLE*|*.local*)
            ;;
        *)
          BAD_ENV_LINE="$trimmed"
          ;;
      esac
      ;;
  esac
done
IFS=$OLDIFS
if [ -n "$BAD_ENV_LINE" ]; then
  fail ".env.example contains a non-placeholder-shaped value: $BAD_ENV_LINE"
fi

# --- 3. no .env / *.pem / *.key ever tracked, anywhere in history ----------

TRACKED_SECRET_PATHS=$(git log --all --pretty=format: --name-only 2>/dev/null | sort -u | grep -E '(^|/)\.env(\.[^/]+)?$|\.pem$|\.key$' | grep -Ev '(^|/)\.env\.(example|sample|template)$')
if [ -n "$TRACKED_SECRET_PATHS" ]; then
  fail "a .env/.pem/.key file was found tracked somewhere in git history: $TRACKED_SECRET_PATHS"
fi

# --- 4. forbidden-hostname grep ---------------------------------------------
# Scope: any http(s):// URL host in full history that is not localhost,
# 127.0.0.1, *.example.com/example.com, or *.local (docs/CONTRACT.md
# section 14's allowed-host list). Restricted to scheme-prefixed URLs so the
# check does not drown in unrelated dotted strings (filenames, version
# numbers) that appear throughout a unified diff.

URL_HOSTS=$(grep -Eio 'https?://[a-zA-Z0-9._-]+' "$TMPFILE" | sed -E 's#https?://##i' | sed -E 's#[:/].*$##' | sort -u)
# Allowed, and why each one is here. The point of this check is to catch a REAL
# production hostname leaking into the repository -- not to ban citing a URL in
# documentation. Anything not on this list still fails, loudly.
#
#   localhost / 127.0.0.1   local development
#   example.com/.org/.net   RFC 2606, reserved for documentation
#   *.example               RFC 6761 reserved TLD -- our XSS test fixtures use it
#   *.local                 mDNS
#   agents.md               the AGENTS.md standard, cited as a source in AGENTS.md
#   download.pytorch.org    the official PyTorch wheel index, in the GPU brief
#
# Added at T-002, when the first npm lockfile was committed. A package-lock.json
# is machine-generated and records where each dependency came from and how its
# author asks to be funded. None of it is ours, none of it is secret, and none of
# it is the thing this check exists to catch -- a REAL production host of OURS.
#
#   registry.npmjs.org      npm's public registry. Every "resolved" line in every
#                           lockfile points at it; 68 of them in server/. Exactly
#                           as legitimate as download.pytorch.org above.
#   github.com              "funding" metadata, and GitHub Sponsors URLs
#   www.patreon.com         "funding" metadata -- e.g. feross, author of several
#                           transitive Express dependencies
#   opencollective.com      "funding" metadata
#   tidelift.com            "funding" metadata
#   feross.org              "funding" metadata -- feross's own site
#   paulmillr.com           "funding" metadata -- paulmillr (chokidar/anymatch)
#
# NOTE for whoever hits this next: funding hosts are an OPEN set. A new dependency
# can introduce one we have not listed, and this gate will stop the push. That is
# the gate working. Add the host here with a line saying what it is -- do not
# broaden the pattern, and do not exempt lockfiles as a file class. A carve-out
# for a whole kind of file is how a floor stops being a floor (EC-005).
#
# Adding a host here is a deliberate act: say what it is and why a reader should
# not be alarmed by it. If you cannot write that sentence, do not add it.
#
#   json-schema.org         the JSON Schema meta-schema namespace, cited as the
#                           $schema keyword's value in server/src/schemas/ir.schema.json
#                           (added at T-019). It is a spec identifier, never fetched
#                           over the network by anything in this repository -- the
#                           same "documentation reference, not a real host" case this
#                           list already carves out for agents.md.
#
#   magicui.design, motion-primitives.com, ui.aceternity.com, www.raycast.com
#                           Cited as sources in docs/MOTION-INSPO.md and
#                           docs/VISUAL-INSPO.md — the design/animation-library
#                           research behind the Studio chrome's token system and
#                           its one signature animated moment (docs/UI-SYSTEM.md
#                           section 5). Same category as agents.md and
#                           json-schema.org above: a documentation reference, not
#                           a real host of ours. Nothing in this repository's
#                           client or server code fetches any of these over the
#                           network — the design system they informed was
#                           ADAPTED (restyled with this project's own studio-*
#                           tokens), never copied or loaded live, per
#                           docs/UI-SYSTEM.md's explicit "adapt, don't copy
#                           verbatim" rule.
#                           (Bare "raycast.com" also appears in prose in
#                           VISUAL-INSPO.md, but this check only scopes
#                           scheme-prefixed URLs, so only www.raycast.com needed
#                           listing here.)
#
#   bedrock-runtime.<region>.amazonaws.com
#                           AWS Bedrock's published service endpoint, cited in
#                           .env.example and in docs/BENCHMARK-RESULTS.md B-005 as the
#                           shape LLM_BASE_URL takes for an OpenAI-compatible hosted
#                           model. Why a reader should not be alarmed: this hostname is
#                           identical for every AWS account on earth. It names no
#                           client, no tenant, no bucket and no private infrastructure,
#                           which is the entire class of thing this gate exists to keep
#                           out of history. Nothing in this repository fetches it -- the
#                           only module that may open a socket to a model provider reads
#                           LLM_BASE_URL from the environment, and .env.example ships a
#                           placeholder.
#
#                           The region is left as a wildcard rather than pinned to
#                           us-east-1 on purpose: pinning it would mean the next person
#                           in another region edits this security file to get a push
#                           through, and editing the floor is exactly the habit this
#                           file is trying not to teach.
#
#   generativelanguage.googleapis.com
#   api.x.ai
#   dashscope.aliyuncs.com
#                           The remaining provider profiles in
#                           server/src/models/providers.js (T-156), admitted on exactly
#                           the same reasoning as bedrock-runtime above and no wider a
#                           one. Each is a vendor's published, globally identical
#                           OpenAI-compatible endpoint: Google Gemini, xAI Grok, and
#                           Alibaba DashScope for Qwen. None names a client, a tenant,
#                           an account or any private infrastructure, which is the class
#                           of thing this gate exists to keep out of history.
#
#                           NOTHING IN THE REPOSITORY FETCHES THESE. They are default
#                           base URLs in a registry, and the registry is data — it holds
#                           no credential and opens no socket. §16.2 still permits
#                           exactly one module to do that, and it reads LLM_BASE_URL
#                           from the environment. .env.example ships them commented as
#                           documentation with every value blank.
#
#                           Deliberately NOT added: localhost:11434 and the other local
#                           runtime hosts, which the `localhost` entry above already
#                           covers.
#
#   ---- T-163: the Design2Code harness, the Studio client, and the frontend drop ----
#
#   Added together because one commit brought all three in. Grouped, but justified
#   one at a time, as this file demands. Read the last block before you push: it is
#   not the same kind of entry as everything above it.
#
#   huggingface.co          Where the Design2Code dataset actually lives. It is named
#                           in tools/design2code/fetch.mjs, which DOES fetch it -- the
#                           benchmark subset is downloaded from the dataset's published
#                           home. A public dataset host, carrying no credential and
#                           naming no tenant of ours.
#
#   fonts.googleapis.com    The Google Fonts @import at the top of client/src/index.css.
#                           Fetched by the browser at page load, exactly as every other
#                           site that uses Google Fonts does. Globally identical, names
#                           nothing of ours.
#
#   assets.emergent.sh      The source a dependency tarball resolves from in
#                           client/package.json and client/package-lock.json. Vendor
#                           artifact hosting, same category as registry.npmjs.org above.
#
#   dotenvx.com             npm "funding" metadata in client/package-lock.json --
#   eslint.org              precisely the OPEN SET this file warns about a few lines
#   polar.sh                up. Three more maintainers asking to be funded; none of it
#                           is ours, none of it is secret. Listed rather than exempting
#                           lockfiles as a file class, per the note above (EC-005).
#
#   ---- the following four come from FrameWright-FrontEnd-main/, a vendored drop ----
#
#   reactjs.org             In that tree's frontend/README.md -- the stock
#   facebook.github.io      Create React App boilerplate README, verbatim.
#   help.github.com         In its two .gitignore files, the stock GitHub comment.
#   ui.shadcn.com           Its frontend/components.json schema URL, the same kind of
#                           spec identifier as json-schema.org above.
#   images.unsplash.com     Placeholder image URLs in its design_guidelines.json.
#   images.pexels.com       Stock-photo hosts, not ours.
#
#   ---- ea.int.apis.emergentagent.com: READ THIS ONE ----
#
#   THIS IS NOT LIKE THE OTHERS. It is a REAL INTERNAL INFRASTRUCTURE HOST, the exact
#   class of thing this check was written to keep out of history, and it is admitted
#   here by an explicit decision made with that fact on the table -- not because anyone
#   judged it harmless.
#
#   It appears once, in FrameWright-FrontEnd-main/.../.emergent/cron/webhook-crons: a
#   pod-local cron file from the Emergent platform that names its internal cron API,
#   alongside a JOB_ID and a path to a /app/backend/.env that is NOT in this repository.
#   It is Emergent's internal host, not ours, and it carries no credential -- but it is
#   internal infrastructure, and it is now permanent in this history.
#
#   Whoever reads this next: the honest fix is to drop FrameWright-FrontEnd-main/ and
#   its .zip from history and delete these six lines with it. That was offered and
#   declined under deadline. Do not treat this entry as precedent for admitting the
#   next internal host -- it is a debt, recorded as one.
#
ALLOWED_HOST_RE='^(localhost|127.0.0.1|([a-z0-9-]+.)?example.(com|org|net)|([a-z0-9-]+.)*example|([a-z0-9-]+.)*[a-z0-9-]+.local|agents.md|download.pytorch.org|registry.npmjs.org|github.com|www.patreon.com|opencollective.com|tidelift.com|feross.org|paulmillr.com|json-schema.org|bedrock-runtime.[a-z0-9-]+.amazonaws.com|bedrock-runtime.|magicui.design|motion-primitives.com|ui.aceternity.com|www.raycast.com|generativelanguage.googleapis.com|api.x.ai|dashscope.aliyuncs.com|assets.emergent.sh|dotenvx.com|ea.int.apis.emergentagent.com|eslint.org|facebook.github.io|help.github.com|fonts.googleapis.com|huggingface.co|images.pexels.com|images.unsplash.com|polar.sh|reactjs.org|ui.shadcn.com)$'

if [ -n "$URL_HOSTS" ]; then
  FORBIDDEN_HOSTS=$(printf '%s\n' "$URL_HOSTS" | grep -Eiv "$ALLOWED_HOST_RE")
  if [ -n "$FORBIDDEN_HOSTS" ]; then
    fail "forbidden hostname(s) in git history: $FORBIDDEN_HOSTS -- only local hosts, RFC-reserved documentation domains, and hosts explicitly declared in this hook are allowed. If it is a legitimate documentation reference, add it to ALLOWED_HOST_RE with a comment. If it is a real host, remove it from history."
  fi
fi

# --- 5. no field IDs outside the sanctioned 1000.../2000.../3000... ranges -

BAD_IDS=$(grep -Eo '"[0-9]{10}"' "$TMPFILE" | tr -d '"' | grep -Ev '^[123][0-9]{9}$' | sort -u)
if [ -n "$BAD_IDS" ]; then
  fail "ID(s) outside the sanctioned 1000.../2000.../3000... ranges found in git history: $BAD_IDS"
fi

# --- 6. no absolute local paths ---------------------------------------------
# Scope note: requires an actual path SEGMENT after the drive/home marker (a
# real-looking username followed by another separator), not just a bare
# mention of "C:\Users\", "/home/", or "/Users/". A bare mention is exactly
# what this repository's own rule-defining prose legitimately contains —
# docs/CONTRACT.md section 14 names these three markers verbatim when it
# documents this very rule, and .claude/hooks/block-dangerous-shell.mjs's
# comments talk about "a root/home/drive-root" as a category of target, not
# an actual path. A real leak is a concrete path with more after the marker;
# this pattern is written to catch that shape without permanently failing on
# the documentation that describes the rule. Known residual gap: a leak that
# is exactly ".../home/username" with nothing after the username on that line
# would not match — flagged, not silently accepted as fully covered.

BAD_PATHS=$(grep -E 'C:\\Users\\[A-Za-z][A-Za-z0-9._-]+\\|/home/[A-Za-z][A-Za-z0-9._-]+/|/Users/[A-Za-z][A-Za-z0-9._-]+/' "$TMPFILE")
if [ -n "$BAD_PATHS" ]; then
  fail "an absolute local path (C:\\Users\\<name>\\, /home/<name>/, or /Users/<name>/) was found in git history"
fi

# --- 7. no model weights ever tracked ---------------------------------------

WEIGHT_FILES=$(git log --all --pretty=format: --name-only 2>/dev/null | sort -u | grep -Ei '\.(pt|onnx|safetensors)$')
if [ -n "$WEIGHT_FILES" ]; then
  fail "model weight file(s) found tracked somewhere in git history: $WEIGHT_FILES"
fi

# --- 8. no duplicate fieldId / fieldIdN in JSON store -----------------------

DUPLICATES=$(git grep -hE '"(fieldId|fieldIdN)"[[:space:]]*:[[:space:]]*"[0-9]{10}"' -- '*.json' 2>/dev/null | grep -Eo '"[0-9]{10}"' | sort | uniq -d)
if [ -n "$DUPLICATES" ]; then
  fail "duplicate fieldId/fieldIdN found in tracked JSON files (atomicity failure): $DUPLICATES"
fi

# --- 9. the section 9 store-liveness invariant ------------------------------
#
# CONTRACT.md section 9 is the single most dangerous property of this design:
# every text node renders as `data?.[id] || "DEFAULT"`, so a dead store renders
# pixel-identical to a working system. It compiles, it lints, it passes schema
# validation and a screenshot diff. It fails only when someone changes a value
# and the preview does not move -- in front of a judge, at the exact moment the
# demo script says to change a headline.
#
# Not hypothetical. Five endpoints once shipped bound to stubs in routes/index.js
# that shadowed their real implementations; GET /api/elements answered 200 []
# whatever the store held, with the whole suite green. See
# docs/corrections/REGISTER.md, 2026-08-21.
#
# It runs on push rather than on commit deliberately. The check renders React for
# real, so it needs BOTH server/node_modules and client/node_modules. On
# pre-commit, fail-closed would mean any teammate who had not installed both
# could not commit at all -- the gate that exists to protect the demo would
# instead stop the build. Push is where work reaches other people, which is the
# boundary this invariant actually needs to hold at.
#
# Fails closed, like every other check here: missing dependencies are a real
# inability to verify the invariant, not a pass.

command -v node >/dev/null 2>&1 || fail "required tool not found on PATH: node"

for DEPS in server/node_modules client/node_modules; do
  [ -d "$DEPS" ] || fail "$DEPS is missing, so the section 9 store-liveness check cannot run. Run npm install in server/ and client/, then push again -- see SETUP.md."
done

node tools/check-store-liveness.mjs
LIVENESS_STATUS=$?
if [ "$LIVENESS_STATUS" -ne 0 ]; then
  fail "the section 9 store-liveness assertion failed. The store is not reaching the rendered preview -- a PATCH would not move the page. Run: npm run check-store-liveness"
fi

exit 0
