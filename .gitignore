# Dependencies
node_modules/

# Uploads and pipeline-generated artifacts — never committed
uploads/
artifacts/
dist/
build/
coverage/
.vite/

# Environment files — every variant is ignored EXCEPT the tracked templates.
# Known failure mode this negation exists to prevent: a bare ".env.*" rule
# with no negation silently swallows ".env.example" too, and ".env.example"
# is a required, scored, tracked deliverable (docs/CONTRACT.md section 14).
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Model weights — licence-bearing binaries never belong in this repository
# (docs/CONTRACT.md section 14; see README.md "Forbidden dependencies").
*.pt
*.onnx
*.safetensors

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
*.log

# Baton identity — per-machine, never shared (docs/BATON.md).
_build/.me

# Baton sync markers — per-machine last-synced commit, one per identity
# (docs/BATON.md, docs/GIT-PROTOCOL.md "Staying in sync").
_build/.sync-*

# Generated by the docs build (Vercel output directory).
public/

# Python — the perception service (docs/CONTRACT.md section 12). Its virtual
# environment carries the CUDA torch build, which is gigabytes of licence-bearing
# binary, and __pycache__ is machine-specific bytecode. Neither belongs here.
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# JSON-store runtime state. The store adapter's default path is
# server/data/store.json (§2.1), and the job store sits beside it. Both are
# written by simply running the app or the suite, so they are byproducts, not
# source. Committed, they made the test suite order-dependent: one suite's
# leftover artifacts/<jobId> directory failed another suite's rmdir with
# ENOTEMPTY, and a stale job record failed regenerate-base. The seed SOURCE
# under server/data/seed/ stays tracked -- that is real, scored input.
server/data/store.json
server/data/jobs.json

# tools scratch files — not deliverables (duplicate seed IDs → pre-push gate)
tools/_store_scratch.json
