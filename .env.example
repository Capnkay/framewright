# Framewright — environment variable template.
#
# Copy this file to .env and fill in real values for your machine:
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. This file (.env.example) IS
# tracked on purpose — every value below is a placeholder, never a real
# secret, real host, or real credential. See docs/CONTRACT.md section 14.

# Frontend (Vite) build — storage host the browser fetches uploaded/generated
# images from.
VITE_STORAGE_URL=http://localhost:5000/storage/

# Frontend (Vite) build — base URL for the Node API.
VITE_API_URL=http://localhost:5000/api

# Node API — MongoDB connection string. Placeholder database name, local host.
MONGODB_URI=mongodb://localhost:27017/framewright_dev

# Node API — hosted LLM used for prompt-to-IR generation (docs/CONTRACT.md
# section 6). Leave unset to run the deterministic generation path only.
#
# UNSET IS A SUPPORTED STATE, not a broken one. AGENTS.md rule 5: generation may
# never REQUIRE a key, a GPU or a network. With no key, orchestrator.js returns
# { ok: false, kind: NO_KEY } without opening a socket, promptToIrHosted falls
# back to promptToIrKeyless, and the IR records why in its own warnings. That is
# the path the demo runs on.
#
# Any OpenAI-compatible endpoint works — the one transport in the repository
# (server/src/models/orchestrator.js, the only module permitted to read these
# variables) posts to `${LLM_BASE_URL}/chat/completions` with a Bearer token.
#
# AWS Bedrock is one such endpoint and needs no adapter. Its OpenAI-compatible
# route is
#   https://bedrock-runtime.<region>.amazonaws.com/openai/v1
# with a Bedrock API key as the bearer token. Measured working against
# qwen.qwen3-coder-next and qwen.qwen3-vl-235b-a22b — see B-005 in
# docs/BENCHMARK-RESULTS.md for what it did and did not do.
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://api.example.com/v1

# Which model the orchestrator asks for. Optional — orchestrator.js has a
# default. Set it when the endpoint serves more than one model, as Bedrock does.
LLM_MODEL=YOUR_LLM_MODEL_ID_HERE

# Node API — local Python perception service (docs/CONTRACT.md section 12).
# Optional: if unreachable, the Node API degrades gracefully per the contract.
PERCEPTION_SERVICE_URL=http://localhost:8000

# Node API — optional Redis cache (docs/CONTRACT.md section 15.1). Leave unset
# to use the in-process cache, which is the reference implementation. An
# unreachable Redis warns once and falls back; it never fails the boot.
REDIS_URL=redis://localhost:6379

# Node API — optional S3-compatible object storage for uploads and artifacts
# (docs/CONTRACT.md section 15.2). Leave the endpoint unset to use local disk,
# which is the default and what sections 11.2 and 13.1 already mandate.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=framewright-sample
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID_HERE
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY_HERE

# Node API — optional embedding service for template and role matching
# (docs/CONTRACT.md section 16.1). Unset means embed() returns null and every
# caller falls back to the deterministic keyword scorer.
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_API_KEY=YOUR_EMBEDDING_API_KEY_HERE

# Node API — optional OpenTelemetry collector (docs/CONTRACT.md section 17.3).
# Unset means spans are dropped silently. The section 11 stage trace is the
# authoritative record either way.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
