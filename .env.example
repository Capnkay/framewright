# Framewright — environment variable template.
#
# Copy this file to .env and fill in real values for your machine:
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. This file (.env.example) IS
# tracked on purpose — every value below is a placeholder, never a real
# secret, real host, or real credential. See docs/CONTRACT.md section 14.

# Frontend (Vite) build — storage host the browser fetches uploaded/generated
# images from.
VITE_STORAGE_URL=http://localhost:5000/storage/

# Frontend (Vite) build — base URL for the Node API.
VITE_API_URL=http://localhost:5000/api

# Node API — MongoDB connection string. Placeholder database name, local host.
MONGODB_URI=mongodb://localhost:27017/framewright_dev

# Node API — hosted LLM used for prompt-to-IR generation (docs/CONTRACT.md
# section 6). Leave unset to run the deterministic generation path only.
LLM_API_KEY=YOUR_LLM_API_KEY_HERE
LLM_BASE_URL=https://api.example.com/v1

# Node API — local Python perception service (docs/CONTRACT.md section 12).
# Optional: if unreachable, the Node API degrades gracefully per the contract.
PERCEPTION_SERVICE_URL=http://localhost:8000
